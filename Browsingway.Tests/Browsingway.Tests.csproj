<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<!-- Compiled from the plugin's own source so the tests exercise the shipped code. The plugin
		     targets net10.0-windows and cannot be referenced as an assembly on a Mac. -->
		<Compile Include="..\Browsingway\CacheSlotPolicy.cs" Link="CacheSlotPolicy.cs" />
		<Compile Include="..\Browsingway\Guarded.cs" Link="Guarded.cs" />
		<Compile Include="..\Browsingway\OverlayStatus.cs" Link="OverlayStatus.cs" />
		<Compile Include="..\Browsingway\RendererStartPolicy.cs" Link="RendererStartPolicy.cs" />
		<Compile Include="..\Browsingway.Renderer\ReadyGate.cs" Link="ReadyGate.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
	</ItemGroup>

</Project>
